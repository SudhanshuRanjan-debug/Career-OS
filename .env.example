# ==========================================
# Career Platform — Environment Configuration
# ==========================================

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True
PORT=8000

# Database (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_local_database_password
POSTGRES_DB=career_platform
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_local_database_password@localhost:5432/career_platform
# Authentication & JWT Security
# Replace with a cryptographically secure random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_random_development_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage Configuration (StorageService abstraction)
# Options: 'local' (development), 'azure' (production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage/private

# Azure Blob Storage (Production only)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=candidate-documents

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# Frontend Public Variables
VITE_API_URL=http://localhost:8000/api/v1
