# ===========================================================================
# Career Platform — Production Environment Variables Template (.env.prod.example)
# Copy this file to .env.prod before launching docker-compose.prod.yml
# NEVER COMMIT REAL PRODUCTION SECRETS OR .env.prod TO SOURCE CONTROL
# ===========================================================================

# Environment Mode
ENVIRONMENT=production

# Debug Mode (Must be false in production)
DEBUG=false

# Allowed Hosts for TrustedHostMiddleware (Comma-separated hostnames/domains — NO WILDCARDS)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Gateway Exposure Port (Default 80)
PROD_PORT=80

# Database Credentials (PostgreSQL 16)
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=generate_a_cryptographically_secure_password_here
POSTGRES_DB=career_platform_prod

# JWT & Authentication Security (Minimum 64 characters recommended)
# Generate with: openssl rand -hex 32
SECRET_KEY=generate_a_strong_random_secret_key_at_least_64_characters_long

# CORS Allowed Origins (Comma-separated or JSON list of client domains)
CORS_ORIGINS=https://yourdomain.com,http://localhost

# Storage Configuration
# Options: 'local' (mounted volume) or cloud providers
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/app/storage
