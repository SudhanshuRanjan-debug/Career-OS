# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Career & Job Application Management Platform"
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# Database (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_local_database_password
POSTGRES_DB=career_platform_dev
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_local_database_password@localhost:5432/career_platform_dev

# JWT Security
SECRET_KEY=replace_with_a_random_development_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage Configuration
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage/private
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=career-documents-private
